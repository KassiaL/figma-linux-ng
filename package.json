{
  "name": "figma-linux-ng",
  "version": "0.12.0-ng.1",
  "description": "Figma Linux NG: modernized fork of Figma Linux (Electron 45, hardware WebGPU on Linux/Vulkan, diagnostics)",
  "main": "dist/main/main.js",
  "repository": "https://github.com/Figma-Linux/figma-linux",
  "homepage": "https://github.com/Figma-Linux/figma-linux",
  "author": "ChugunovRoman <Zebs-BMK@yandex.ru>",
  "license": "MIT",
  "scripts": {
    "start": "run-s build run",
    "dev": "run-s rollup:dev",
    "run": "electron dist",
    "run:watch": "nodemon --config ./config/nodemon.json",
    "rollup": "rollup -c ./config/rollup.renderer.config.mjs",
    "rollup:main": "rollup -c ./config/rollup.main.config.mjs",
    "rollup:dev": "run-p rollup:main rollup:watch",
    "rollup:watch": "rollup -c ./config/rollup.renderer.config.mjs -w",
    "build": "npm run cln && run-p rollup:main rollup",
    "builder": "electron-builder --config=config/builder.json -l",
    "package": "rm -rf build/installers && npm run build && electron-builder --config=config/builder.json -l deb AppImage",
    "check": "svelte-check",
    "lp": "run-p lint prettier",
    "lint": "eslint -c ./config/.eslintrc.js src/**/*.ts",
    "prettier": "prettier src/{**/,*/**/,**/**/**/,**/**/**/**/,**/**/**/**/**/,**/**/**/**/**/**/}*.ts --write",
    "cln": "rm -rf ./dist",
    "package:deb": "rm -rf build/installers && npm run build && electron-builder --config=config/builder.json -l deb",
    "package:appimage": "rm -rf build/installers && npm run build && electron-builder --config=config/builder.json -l AppImage",
    "diag:webgpu": "node scripts/diag/run-webgpu-probe.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "dotenv": "^16.0.3",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.33.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "nodemon": "^2.0.20",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.3",
    "rollup": "^4.65.0",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-css-only": "^4.3.0",
    "rollup-plugin-dev": "^2.0.4",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte-check": "^3.8.6",
    "svelte-preprocess": "^5.1.4",
    "typescript": "^5.9.3",
    "tslib": "^2.8.1",
    "svelte": "^4.2.20"
  },
  "keywords": [
    "Figma",
    "linux",
    "Electron",
    "desktop",
    "app"
  ]
}
